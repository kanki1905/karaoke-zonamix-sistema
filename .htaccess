Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Carpetas internas: no accesibles desde el navegador
RewriteRule ^(config|controllers|models|views|helpers|database)(/|$) - [F,L]

# Todo lo que no sea un archivo/carpeta real va a index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
</IfModule>
